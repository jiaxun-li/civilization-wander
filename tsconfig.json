{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "data/**/*.ts",
    "tests/fixtures/module-gate-valid.ts",
    "vite.config.mts"
  ],
  "exclude": [
    "src/knowledge-space/**"
  ]
}
